{
  "kind": "collectionType",
  "collectionName": "replies",
  "info": {
    "singularName": "reply",
    "pluralName": "replies",
    "displayName": "Reply",
    "description": "Réponses aux discussions de la communauté"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "content": {
      "type": "text",
      "required": true,
      "minLength": 2
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "discussion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::discussion.discussion",
      "inversedBy": "replies"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "replies"
    }
  }
}
