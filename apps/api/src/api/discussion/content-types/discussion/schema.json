{
  "kind": "collectionType",
  "collectionName": "discussions",
  "info": {
    "singularName": "discussion",
    "pluralName": "discussions",
    "displayName": "Discussion",
    "description": "Discussions, questions et sondages de la communauté"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 10,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true,
      "minLength": 2
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "question",
        "discussion",
        "poll"
      ],
      "default": "question",
      "required": true
    },
    "views": {
      "type": "integer",
      "default": 0
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "enumeration",
      "enum": [
        "none",
        "question",
        "poll"
      ],
      "default": "none"
    },
    "poll_options": {
      "type": "json"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "discussions"
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reply.reply",
      "mappedBy": "discussion"
    },
    "solution": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::reply.reply"
    }
  }
}
