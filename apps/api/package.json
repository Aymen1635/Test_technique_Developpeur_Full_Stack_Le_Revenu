{
  "name": "community-api",
  "version": "1.0.0",
  "private": true,
  "description": "Strapi v5 API for Le Revenu Community",
  "scripts": {
    "dev": "node --import ./scripts/copy-jsons.mjs --import ./scripts/database-bootstrap.mjs ../../node_modules/@strapi/strapi/bin/strapi.js develop",
    "develop": "node --import ./scripts/copy-jsons.mjs --import ./scripts/database-bootstrap.mjs ../../node_modules/@strapi/strapi/bin/strapi.js develop",
    "prestart": "node scripts/copy-jsons.mjs",
    "start": "node --import ./scripts/database-bootstrap.mjs ../../node_modules/@strapi/strapi/bin/strapi.js start",
    "build": "strapi build",
    "postbuild": "node scripts/copy-jsons.mjs",
    "strapi": "node --import ./scripts/database-bootstrap.mjs ../../node_modules/@strapi/strapi/bin/strapi.js",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "^5.5.0",
    "@strapi/strapi": "^5.5.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "slugify": "^1.6.6",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.14",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "community-le-revenu-api"
  }
}
