# If using PostgreSQL:
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=community_lerevenu
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
