{
  "name": "community-le-revenu",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme communautaire Le Revenu - Next.js, Strapi v5, PostgreSQL",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "build": "cd apps/api && npm run build && cd ../web && npm run build",
    "test": "cd apps/api && npm run test",
    "test:e2e": "playwright test",
    "seed": "cd apps/api && npm run seed"
  },
  "keywords": [
    "le-revenu",
    "nextjs",
    "strapi",
    "postgresql",
    "typescript",
    "tailwind"
  ],
  "author": "Le Revenu Technical Candidate",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@strapi/plugin-users-permissions": "^5.59.0",
    "@strapi/strapi": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "styled-components": "^6.1.13"
  }
}
